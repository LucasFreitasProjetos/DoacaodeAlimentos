<!DOCTYPE web-app PUBLIC
 "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
 "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app>
  <display-name>Archetype Created Web Application</display-name>

  <servlet>
    <servlet-name>DoadorApiServlet</servlet-name>
    <servlet-class>br.com.doacaoalimentos.api.DoadorApiServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>DoadorApiServlet</servlet-name>
    <url-pattern>/api/doador/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>InstituicaoApiServlet</servlet-name>
    <servlet-class>br.com.doacaoalimentos.api.InstituicaoApiServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>InstituicaoApiServlet</servlet-name>
    <url-pattern>/api/instituicao/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>DoacaoApiServlet</servlet-name>
    <servlet-class>br.com.doacaoalimentos.api.DoacaoApiServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>DoacaoApiServlet</servlet-name>
    <url-pattern>/api/doacao/*</url-pattern>
  </servlet-mapping>
</web-app>
